{
  "name": "deal-explorer-mcp",
  "version": "1.0.0",
  "description": "MCP Server for DIO Deal Explorer — exposes /trilha, /desafio and /certificado as tools via stdio and HTTP/SSE",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "start:http": "MCP_TRANSPORT=http node build/index.js",
    "dev": "npx tsx src/index.ts"
  },
  "bin": {
    "deal-explorer-mcp": "./build/index.js"
  },
  "files": ["build"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.2",
    "zod": "^3.22.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5"
  }
}
